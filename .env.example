# Copy this file to .env (which is git-ignored) and fill in real values.
# Never commit .env.

# ----- Remote GPU server (deployment_tools/deploy_to_gpu.py, deployment_tools/run_remote.py) -----
GPU_HOST=gpu-host.example.com
GPU_PORT=22
GPU_USER=root
GPU_PASSWORD=change-me
GPU_REMOTE_DIR=/workspace

# ----- Web control server (hardware_control/web_control.py) -----
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random key is generated at every start.
FLASK_SECRET_KEY=
